{
  "_updateLog": [
    "[2026-11-20] type=feat - v1.0.0_001: AutoBotHtsH 첫 버전 - HtsH(v0.1.5_002) 화면(MDI 창: 차트/현재가/종목정보/관심종목/순위/지수/뉴스, KIS 조회 전용)에 AutoBotH(v2.3.32_003) 기능을 창 종류로 추가: 봇 제어/데이터 작업/수집기/파이프라인/종목 보드/타임라인/봇 차트/보유 현황/매매 결과/가상 매매/봇 설정·연결 (툴바 봇 메뉴). 이름이 겹치는 기능은 봇 쪽에 봇 접두(봇 차트, 봇 설정·연결). 별도 앱(kr.xgraph.autobothtsh, %APPDATA%/autobothtsh) - 첫 실행 때 AutoBotH 연결 설정(비밀번호 제외)과 HtsH 관심종목을 가져옴. 로컬 모드 스케줄러(틱 수집기/장 마감 작업/감시목록 복사)는 AutoBotH 와 공유 잠금으로 한 앱에서만 실행"
  ],
  "name": "autobothtsh",
  "version": "1.0.0",
  "description": "HtsH(KIS 조회 전용 HTS) + AutoBotH(r003 파이프라인 뷰어·원격 제어) 통합 앱",
  "author": "xgraph <xgraph.kr@gmail.com>",
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "prestart": "node scripts/version.cjs",
    "start": "electron-vite build && node scripts/start.cjs preview",
    "predev": "node scripts/version.cjs",
    "dev": "node scripts/start.cjs dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "sync-spec": "node scripts/sync-kis-spec.cjs",
    "predist": "node scripts/version.cjs",
    "dist": "electron-vite build && node scripts/electron-builder.cjs --publish never",
    "postdist": "node scripts/release.cjs --yml-only",
    "release": "npm run dist && node scripts/release.cjs",
    "icon": "node scripts/make-icon.cjs",
    "scope-css": "node scripts/scope-bot-css.cjs"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "ssh2": "^1.16.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^1.1.8",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.7.0",
    "@xyflow/react": "^12.12.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.5.32",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "zustand": "^5.0.16"
  },
  "build": {
    "publish": {
      "provider": "generic",
      "url": "https://update.iccid.dev/AutoBotHtsH/"
    },
    "buildNumber": "001",
    "appId": "kr.xgraph.autobothtsh",
    "productName": "AutoBotHtsH",
    "copyright": "Copyright © 2026 xgraph",
    "npmRebuild": false,
    "files": [
      "out/**/*",
      "resources/**/*",
      "version.txt",
      "updater.js",
      "app-about.js",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "ko_KR",
        "en_US"
      ],
      "shortcutName": "AutoBotHtsH",
      "uninstallDisplayName": "AutoBotHtsH",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "AutoBotHtsH_Setup_v${version}_${buildNumber}.${ext}"
    },
    "portable": {
      "artifactName": "AutoBotHtsH_Setup_v${version}_${buildNumber}_Portable.${ext}"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    }
  }
}
