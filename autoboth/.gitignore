# Update log
# - [2026-11-04] type=chore (v2: ignore fixtures/ - copies of real trading logs used by the vitest acceptance tests)
# - [2026-10-02] type=feat (Cleanup for GitHub source control: exclude build output/dependencies/logs/personal settings. build/ is not excluded because it holds build resources (source) such as icons)

# Dependencies (restored by npm install)
node_modules/

# Build output (regenerated by npm run dist)
dist/
out/
release/

# Runtime logs (may contain connected hosts/IPs)
logs/
*.log
npm-debug.log*

# Secrets / personal environment
.env
.env.*
*.pem
*.key

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
*.code-workspace

# Real log copies for tests (trading data, fixtures/YYYYMMDD from runtime/log)
fixtures/
